
{
 "version": "0.2.0",
 "configurations": [
  {
   "name": "Debug Nestar API",
   "type": "node",
   "request": "launch",
   "runtimeExecutable": "npm",
   "runtimeArgs": ["run", "start:debug"],
   "cwd": "${workspaceFolder}",
   "console": "integratedTerminal",
   "restart": true,
   "autoAttachChildProcesses": true,
   "sourceMaps": true,
   "skipFiles": ["<node_internals>/**"]
  }
 ]
}